// C910 同一个 Load 在 pipe3 RF 依次遇到读端口冲突、AG 占用，再成功下传。
// LSIQ 第 2 项较新。LSIQ 第 1 项已在 LD AG，等待 D-cache 仲裁直到 C3。
// C0、C2、C4 是按示例仲裁选择的三次 RF 尝试。
// 每列为一个 forever_cpuclk 周期。x 表示该拍未标注信号值。
{
  signal: [
    {"name":"forever_cpuclk","wave":"p......"},
    ["Pipe3",
      {"name":"idu_lsu_rf_pipe3_gateclk_sel","wave":"101010."},
      {"name":"idu_lsu_rf_pipe3_sel","wave":"0.1010."},
      {"name":"idu_lsu_rf_pipe3_lch_entry","wave":"4x4x4x.","data":["0x004","0x004","0x004"]},
    ],
    ["IDU",
      {"name":"ctrl_lsiq_rf_pipe3_lch_fail_vld","wave":"10.....","node":"A......"},
      {"name":"lsiq_entry2_frz","wave":"10101..","node":".B.D..."},
      {"name":"lsiq_entry2_issue_en","wave":"01010.."},
    ],
    ["LSU",
      {"name":"ld_ag_stall_ori","wave":"1..0..."},
      {"name":"ld_ag_inst_vld","wave":"1...010"},
      {"name":"ld_ag_lsid","wave":"4...x4x","data":["0x002","0x004"]},
      {"name":"lsu_idu_wakeup[2]","wave":"0.10...","node":"..C...."},
    ],
  ],
  head: { text: 'C910 RF 发射失败与 AG 冲突', tock: 0 },
  edge: ["A~>B","C~>D"],
  config: { skin: 'narrow', hscale: 4 },
}
